{
  "name": "chicappd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server:dev": "wrangler dev --local --port 8787",
    "server:check": "tsc --noEmit --moduleResolution bundler --module esnext --target es2022 --skipLibCheck --allowImportingTsExtensions --types @cloudflare/workers-types server/worker.ts && wrangler deploy --dry-run",
    "server:deploy": "wrangler deploy",
    "test:online": "node --experimental-strip-types --test tests/online.integration.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.142.0"
  }
}
