# Public Cloudflare Worker URL returned by `npm run server:deploy`.
# Set this as GitHub Actions repository variable MULTIPLAYER_API_URL for Pages builds.
VITE_MULTIPLAYER_API_URL=https://chicappd-rooms.YOUR-SUBDOMAIN.workers.dev

# Optional Supabase foundation. Copy the project URL and public publishable key
# from the Supabase project's Connect dialog / API settings.
# Leave blank to keep Supabase disabled; guest play and local history still work.
# VITE_* values are public browser configuration. Never use a secret/service-role key.
# Supabase Email provider must have Confirm email OFF for mailbox-free accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
